# ─── Server ────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ─── Database (Sequelize + MySQL) ──────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=flipkart_db
DB_USER=root
DB_PASSWORD=Bharathi@123
DB_DIALECT=mysql

# ─── JWT Auth ───────────────────────────────────
JWT_SECRET=fli_super_secret_change_me_9876543210
JWT_EXPIRES_IN=7d

JWT_REFRESH_SECRET=fli_refresh_secret_change_me_0123456789
JWT_REFRESH_EXPIRES_IN=30d

# ─── File Uploads ───────────────────────────────
UPLOAD_MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# ─── Rate Limiting ───────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# ─── Product status checker ───────────────────────
PRODUCT_STATUS_CHECK_INTERVAL_MS=900000

# ─── Order status checker (automatic progression) ──
# How often the job scans orders
ORDER_STATUS_CHECK_INTERVAL_MS=60000
# How long an order stays "Processing" before it auto-ships
ORDER_PROCESSING_TO_SHIPPED_MS=60000
# Total time after which a shipped order auto-delivers
ORDER_SHIPPED_TO_DELIVERED_MS=120000
# Unpaid (non-COD) orders still pending after this long are auto-cancelled
ORDER_AUTO_CANCEL_AFTER_MS=1800000
